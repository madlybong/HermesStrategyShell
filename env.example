# === Assets ===
# Path to the master contract dump (from NSE)
ASSET_CONTRACT_PATH=contract.csv
# Path to the strategy-specific symbol whitelist
ASSET_FNO_FILE=FnoStocks.csv

# === Portal ===
# Network interface for multicast receive (0.0.0.0 for any)
PORTAL_INTERFACE_IP=0.0.0.0
# Filter for specific underlying symbols (comma-separated, e.g. NIFTY,BANKNIFTY). Leave empty for all.
PORTAL_ALLOW_SCRIPTS=
# Filter for specific expiries (comma-separated, e.g. 26MAR2026). Leave empty for all.
PORTAL_FO_EXPIRIES=
# Receive buffer size in bytes (0 = OS default)
PORTAL_RCVBUF_SIZE=0
# Market depth level to track (0 = Touch, up to 4 = deep)
MARKET_DATA_LEVEL=0

# === Execution ===
# Master kill switch: true = place orders, false = signals only
TRADE_ENABLED=false
# Dry run: true = simulated local fills, false = dispatch to broker
TRADE_DRY_RUN=true
# Mode: PARALLEL or SEQUENTIAL (legacy)
EXECUTION_MODE=PARALLEL
# Target broker engine: greeksoft or saralmsmq or local
EXECUTION_ENGINE=greeksoft
# Number of parallel execution worker threads
EXECUTION_POOL_SIZE=8

# === Timing ===
# How often to poll order status (ms)
POLL_INTERVAL_MS=500
# Reject ticks older than this (seconds). 0 = disabled.
LTT_RANGE=0
# Cooldown between signals per pair/symbol (minutes)
MIN_SIGNAL_COOLDOWN_MIN=1

# TODO: Add your strategy-specific timing configs below
# Wait for FAR leg fill before cancel (ms)
FAR_WAIT_MS=60000
# Wait for NEAR leg fill before DPR upgrade (ms)
NEAR_WAIT_MS=5000
FUT_WAIT_MS=500
OPT_WAIT_MS=50

# === Charges ===
# STT flat charge (usually 0.9 or similar per lot)
FIXED_STT=0.9
# Annualized interest rate (e.g. 0.12 for 12%)
INTEREST_CHARGES=0.12
# Margin basis for interest calculation per lot
INTEREST_MARGIN_BASE=80000.0
# Fixed future charge multiplier per crore
FUTURE_CHARGES=1500.0
# Fixed option charge multiplier per crore
OPTION_CHARGES=13000.0
INDEX_FUT_MULTIPLIER=2.0
STOCK_FUT_MULTIPLIER=2.0

# === Engines: GreekSoft ===
GREEK_API_HOST=127.0.0.1
GREEK_API_PORT=3303
GREEK_API_TOKEN=your_token_here
GREEKS_GCID=your_gcid
GREEKS_GSCID=your_gscid
GREEKSOFT_DEVICE_TYPE=0
GREEKSOFT_SESSION_VALID_FOR=30d
GREEKSOFT_IRIS_WS_URL=
GREEKSOFT_IRIS_PORT=
GREEKSOFT_HEARTBEAT_INTERVAL_MS=0

# === Engines: SaralMSMQ ===
SARAL_MSMQ_CLIENT=
SARAL_MSMQ_HOST=127.0.0.1
SARAL_MSMQ_EXCHANGE=NseFO
SARAL_MSMQ_CLIENT_TYPE=Pro
SARAL_MSMQ_BOOK_TYPE=RL
SARAL_MSMQ_PRODUCT=Normal

# === Engines: TradeX ===
TRADEX_HOST=127.0.0.1
TRADEX_PORT=8080
TRADEX_CLIENT_CODE=
TRADEX_AUTH_TOKEN=

# === Logging ===
# Subdirectory under logs/ where all log files are written (e.g. logs/strategy/).
# Override per project: LOG_DIR_NAME=hermes-box
LOG_DIR_NAME=strategy

# CSV header row written once when the daily op-log is first created.
# Leave empty to suppress the header. Strategy projects provide their own columns.
# Example: OP_LOG_HEADER=Timestamp,Symbol,Tag,Field1,Field2
OP_LOG_HEADER=
