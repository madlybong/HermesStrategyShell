# ==========================================
# HermesFutCashStrategy Configuration
# ==========================================

# --- Assets ---
ASSET_CONTRACT_PATH=contract.csv
ASSET_FNO_FILE=FnoStocks.csv

# --- Portal ---
PORTAL_INTERFACE_IP=0.0.0.0
# CRITICAL: Both EQ and FO feeds must be listed for Cash-Fut Arb
PORTAL_FEEDS=NSE:FO:233.1.2.5:34330,NSE:EQ:233.1.2.5:34074
PORTAL_FO_EXPIRIES=28JUL2026
PORTAL_RCVBUF_SIZE=8388608
MARKET_DATA_LEVEL=0

# --- Strategy Logic ---
EXPIRY=28JUL2026
MIN_ROI_PCT=0.50
SLIPPAGE_POINTS=2.0

# --- Charges (per crore of turnover) ---
FUTURE_CHARGES=3000.0
EQUITY_STT_BUY_PCT=0.1
EQUITY_STT_SELL_PCT=0.1
EQUITY_EXCHANGE_FEE=33.5
EQUITY_SEBI_FEE=1.0
EQUITY_STAMP_DUTY=15.0

# --- Exits ---
MARGIN_PER_TRADE=500000.0
EXIT_PROFIT_PCT=50.0
STOP_LOSS_PCT=80.0
TIME_EXIT_DAYS=3

# --- Execution ---
TRADE_ENABLED=false
TRADE_DRY_RUN=true
EXECUTION_ENGINE=local
EXECUTION_MODE=SEQUENTIAL
EXECUTION_POOL_SIZE=4
ORDER_SEQ_FILE=hermes_refno.seq

# --- Timing ---
POLL_INTERVAL_MS=500
LTT_RANGE=0
MIN_SIGNAL_COOLDOWN_MIN=1
FUT_WAIT_MS=60000
CASH_WAIT_MS=5000
EXIT_REPRICE_WAIT_MS=10000

# --- Trading Window ---
TRADE_START=09:15
TRADE_STOP=15:25
STARTUP_WARMUP_SEC=30

# --- Logging ---
LOG_DIR_NAME=hermes-futcash
OP_LOG_HEADER=Time,Symbol,Action,Spread,Threshold,Expense,NearPrice,FarPrice,NearToken,FarToken,NearQty,FarQty,NearStrat,FarStrat
LOGGER_CORE=-1
